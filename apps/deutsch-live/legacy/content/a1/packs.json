      "dialogue": {
        "setting": "Your first day at a language course. The person next to you starts talking.",
        "steps": [
          {"npc": "Hallo! Ich bin Jonas. Und du?", "npc_en": "Hi! I'm Jonas. And you?",
           "options": [
             {"de": "Ich heiße Sam. Freut mich!", "ok": true},
             {"de": "Ich heißt Sam.", "ok": false, "why": "With ich the verb ends in -e: ich heiße."},
             {"de": "Mein Name bin Sam.", "ok": false, "why": "Mein Name ist … (ist, not bin)."}
           ]},
          {"npc": "Freut mich auch! Woher kommst du?", "npc_en": "Nice to meet you too! Where are you from?",
           "options": [
             {"de": "Ich komme aus Kanada.", "ok": true},
             {"de": "Ich komme von Kanada.", "ok": false, "why": "For countries and cities of origin use aus: aus Kanada."},
             {"de": "Ich wohne aus Kanada.", "ok": false, "why": "wohnen means to live somewhere: Ich wohne in …"}
           ]},
          {"npc": "Cool! Und wo wohnst du jetzt?", "npc_en": "Cool! And where do you live now?",
           "options": [
             {"de": "Jetzt wohne ich in Hamburg.", "ok": true},
             {"de": "Jetzt ich wohne in Hamburg.", "ok": false, "why": "The verb is always in position 2: Jetzt wohne ich …"},
             {"de": "Jetzt wohne ich nach Hamburg.", "ok": false, "why": "nach is for direction. Living somewhere uses in."}
           ]},
          {"npc": "Was machst du beruflich?", "npc_en": "What do you do for work?",
           "options": [
             {"de": "Ich arbeite als Krankenpfleger.", "ok": true},
             {"de": "Ich arbeite als ein Krankenpfleger.", "ok": false, "why": "No article after als for jobs: Ich arbeite als Krankenpfleger."},
             {"de": "Ich bin von Beruf arbeiten.", "ok": false, "why": "Say: Ich bin Krankenpfleger von Beruf."}
           ]}
        ]
      }
    },
