      "dialogue": {
        "setting": "You call a doctor's practice to make an appointment.",
        "steps": [
          {"npc": "Praxis Dr. Weber, guten Tag. Was kann ich für Sie tun?", "npc_en": "Dr. Weber's practice, hello. What can I do for you?",
           "options": [
             {"de": "Guten Tag, ich brauche einen Termin.", "ok": true},
             {"de": "Guten Tag, ich brauche ein Termin.", "ok": false, "why": "Termin is masculine (der). After brauchen it takes the accusative: einen Termin."},
             {"de": "Hallo, ich will Termin.", "ok": false, "why": "Too blunt and missing the article: Ich brauche einen Termin."}
           ]},
          {"npc": "Geht es am Donnerstag um halb zehn?", "npc_en": "Does Thursday at half past nine work?",
           "options": [
             {"de": "Ja, um 9:30 Uhr passt gut.", "ok": true},
             {"de": "Ja, um 10:30 Uhr passt gut.", "ok": false, "why": "halb zehn means half an hour BEFORE ten: 9:30."},
             {"de": "Ja, am halb zehn passt gut.", "ok": false, "why": "Clock times use um: um halb zehn."}
           ]},
          {"npc": "Gut. Wie ist Ihr Name, bitte?", "npc_en": "Good. What is your name, please?",
           "options": [
             {"de": "Mein Name ist Sam Taylor.", "ok": true},
             {"de": "Mein Name heißt Sam Taylor.", "ok": false, "why": "Either Ich heiße … or Mein Name ist …"},
             {"de": "Ich bin Name Sam Taylor.", "ok": false, "why": "Say: Mein Name ist Sam Taylor."}
           ]},
          {"npc": "Also Donnerstag, 9:30 Uhr. Bis dann!", "npc_en": "So Thursday, 9:30. See you then!",
           "options": [
             {"de": "Vielen Dank, auf Wiederhören!", "ok": true},
             {"de": "Danke, auf Wiedersehen bis!", "ok": false, "why": "On the phone Germans say auf Wiederhören (hear you again)."},
             {"de": "Tschüss, bis gestern!", "ok": false, "why": "gestern means yesterday. Use bis Donnerstag or auf Wiederhören."}
           ]}
        ]
      }
    },
