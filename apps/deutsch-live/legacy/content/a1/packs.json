        {"de": "Ich bin neu hier.", "pos": "phrase", "en": "I am new here.", "ex": "Hallo, ich bin neu hier.", "ex_en": "Hi, I am new here."},
        {"de": "Wie bitte?", "pos": "phrase", "en": "Pardon? / Sorry?", "ex": "Wie bitte? Noch einmal, bitte.", "ex_en": "Pardon? Once more, please."}
