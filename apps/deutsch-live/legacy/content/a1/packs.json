        "steps": [
          {"npc": "Wann stehst du normalerweise auf?", "npc_en": "When do you usually get up?",
           "options": [
             {"de": "Ich stehe um halb sieben auf.", "ok": true},
             {"de": "Ich aufstehe um halb sieben.", "ok": false, "why": "aufstehen is separable: Ich stehe … auf."},
             {"de": "Ich stehe auf um halb sieben.", "ok": false, "why": "The prefix auf goes to the end of the clause."}
           ]},
          {"npc": "Und wann fängt deine Arbeit an?", "npc_en": "And when does your work start?",
           "options": [
             {"de": "Meine Arbeit fängt um acht Uhr an.", "ok": true},
             {"de": "Meine Arbeit anfängt um acht Uhr.", "ok": false, "why": "Separable: fängt … an."},
             {"de": "Meine Arbeit fangt um acht Uhr an.", "ok": false, "why": "anfangen changes its vowel: es fängt."}
           ]},
          {"npc": "Was machst du nach dem Feierabend?", "npc_en": "What do you do after work?",
           "options": [
             {"de": "Ich kaufe ein und dann koche ich.", "ok": true},
