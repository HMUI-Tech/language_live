      "dialogue": {
        "setting": "Saturday morning at a busy bakery. It's your turn.",
        "steps": [
          {"npc": "Guten Morgen! Was darf's sein?", "npc_en": "Good morning! What can I get you?",
           "options": [
             {"de": "Guten Morgen! Ich hätte gern drei Brötchen.", "ok": true},
             {"de": "Guten Morgen! Ich hätte gern drei Brötchens.", "ok": false, "why": "Brötchen stays the same in the plural: drei Brötchen."},
             {"de": "Morgen! Gib mir drei Brötchen.", "ok": false, "why": "Use Sie and a polite form with staff: Ich hätte gern …"}
           ]},
          {"npc": "Gerne. Sonst noch etwas?", "npc_en": "Sure. Anything else?",
           "options": [
             {"de": "Ja, ein Stück Käsekuchen, bitte.", "ok": true},
             {"de": "Ja, eine Stück Käsekuchen, bitte.", "ok": false, "why": "Stück is neuter (das): ein Stück."},
             {"de": "Ja, ein Stück von Käsekuchen, bitte.", "ok": false, "why": "No von needed: ein Stück Käsekuchen."}
           ]},
          {"npc": "Zum Mitnehmen oder hier essen?", "npc_en": "To take away or eat in?",
           "options": [
             {"de": "Zum Mitnehmen, bitte.", "ok": true},
             {"de": "Für mitnehmen, bitte.", "ok": false, "why": "The fixed phrase is zum Mitnehmen."},
             {"de": "Ich esse mitnehmen.", "ok": false, "why": "Say: Zum Mitnehmen, bitte."}
           ]},
          {"npc": "Das macht 5,40 Euro. Bar oder mit Karte?", "npc_en": "That's 5.40. Cash or card?",
           "options": [
             {"de": "Mit Karte, bitte.", "ok": true},
             {"de": "Mit die Karte, bitte.", "ok": false, "why": "mit takes the dative, and here no article: mit Karte."},
             {"de": "Durch Karte, bitte.", "ok": false, "why": "Paying by card is mit Karte."}
           ]}
        ]
      }
